# Copy to testnet.env and fill in. NEVER commit testnet.env. NO private keys in this file:
# Solana keys are referenced by FILE PATH, Ethereum deployer by Foundry keystore NAME (cast wallet import).

# ---- pinned upstream ----
HYPERLANE_REF=f556e18c9da88ce3d51a24164f22a7f27eb539fd   # agents-v3.0.0 (programs, client and agents from ONE commit)
REGISTRY_REF=05582adc443835a2f9e308c5697a69d51ef3eb88

# ---- workspace ----
WORK=$HOME/vmpx-bridge-testnet          # all build outputs, environments, logs

# ---- X1 testnet ----
X1_RPC=https://rpc.testnet.x1.xyz        # better: your own testnet RPC node
X1_DOMAIN=1479626325
X1_PAYER_KEYPAIR=$HOME/.config/solana/vmpx-testnet-deployer.json   # funded with testnet XNT
X1_TEST_USER_KEYPAIR=$HOME/.config/solana/vmpx-testnet-user.json   # for e2e transfers

# ---- Sepolia ----
SEPOLIA_RPC=https://ethereum-sepolia.publicnode.com
SEPOLIA_DOMAIN=11155111
ETH_ACCOUNT=vmpx-testnet-deployer          # `cast wallet import vmpx-testnet-deployer --interactive`
ETH_TEST_USER_ACCOUNT=vmpx-testnet-user
SAFE=0x0000000000000000000000000000000000000000      # testnet: may be an EOA you control
GUARDIAN=0x0000000000000000000000000000000000000000  # testnet: an EOA you control (keystore below)
GUARDIAN_ACCOUNT=vmpx-testnet-guardian
PAUSERS=0x0000000000000000000000000000000000000000   # csv of single keys that may pauseAll (on-call, monitor bot)
PAUSER_ACCOUNT=vmpx-testnet-pauser                 # keystore of one of PAUSERS, used by 08-e2e.sh
PRICE_BOT=0x0000000000000000000000000000000000000000
BENEFICIARY=0x0000000000000000000000000000000000000000   # receives the fixed 0.0002 ETH hook fee
TREASURY=0x0000000000000000000000000000000000000000      # receives the 3% VMPX bridge fee (router); must differ from BENEFICIARY
BRIDGE_FEE_BPS=300
TIMELOCK_DELAY=300                         # 5 min on testnet (mainnet: 172800 = 48 h)
RATE_CAP=1036800000000000000000000         # 1,036,800 VMPX / 24 h (MUST be a multiple of 86400)

# ---- attestors (addresses only; keys live on the validator servers / KMS) ----
# signers for X1-origin checkpoints (unlock on Sepolia)
X1_VALIDATORS=0x...,0x...,0x...
X1_THRESHOLD=2
# signers for Sepolia-origin checkpoints (mint on X1): Hyperlane's PUBLIC Sepolia validator set (option A, as planned
# for mainnet) — Abacus Works, from hyperlane-monorepo typescript/sdk/src/consts/multisigIsm.ts (sepolia, threshold 1).
# Running our own needs an archive Sepolia RPC: a validator rebuilds the whole merkle tree (~873k leaves) first.
SEPOLIA_VALIDATORS=0x3c659e0fe8d01b80d7828b421630085777346e7c
SEPOLIA_THRESHOLD=1

# ---- X1 -> Sepolia delivery cost (paid by the X1 user in XNT through the Sealevel IGP; M-1) ----
ETH_USD=3000            # used only to compute the IGP exchange rate; update before deploy
XNT_USD=0.24
SEPOLIA_GAS_GWEI=2
X1_TO_ETH_GAS=400000    # gas for process() on Sepolia incl. aggregation ISM (measured 395-405k in stage A)

# expected X1 authorities for the post-deploy acceptance check in 08-e2e.sh (check-x1.mjs fails closed when unset).
# On testnet these are usually the deployer's public key; on mainnet the Squads vault. "none" = immutable program.
X1_EXPECT_UPGRADE_AUTHORITY=__deployer_or_squads_pubkey__
X1_EXPECT_METADATA_AUTHORITY=__deployer_or_squads_pubkey__
X1_EXPECT_TOKEN_OWNER=__deployer_or_squads_pubkey__
# X1 owner (one entity) must also own the mailbox outbox, the multisig ISM and the IGPs (checked against X1_EXPECT_TOKEN_OWNER)
X1_EXPECT_IGP_BENEFICIARY=__treasury_pubkey__
