# One file per validator server. Secrets via KMS — no raw keys in files.
HYP_ORIGINCHAINNAME=x1
HYP_DB=/data/validator-x1
HYP_CHAINS_X1_CUSTOMRPCURLS=http://127.0.0.1:8899          # your own X1 RPC on the same box
HYP_CHAINS_X1_BLOCKS_REORGPERIOD=0                          # sealevel agents read finalized commitment
HYP_VALIDATOR_TYPE=aws
HYP_VALIDATOR_ID=alias/vmpx-bridge-validator-x1-01
HYP_VALIDATOR_REGION=eu-central-1
HYP_CHECKPOINTSYNCER_TYPE=s3
HYP_CHECKPOINTSYNCER_BUCKET=vmpx-bridge-val-x1-01
HYP_CHECKPOINTSYNCER_REGION=eu-central-1
# key that pays the one-time ValidatorAnnounce tx on X1 (tiny XNT balance)
HYP_CHAINS_X1_SIGNER_TYPE=hexKey
HYP_CHAINS_X1_SIGNER_KEY=__FROM_SECRET_STORE__
HYP_METRICSPORT=9090
