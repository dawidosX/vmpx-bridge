HYP_RELAYCHAINS=ethereum,x1
HYP_DB=/data/relayer
HYP_CHAINS_ETHEREUM_CUSTOMRPCURLS=__ETH_RPC_1__,__ETH_RPC_2__
HYP_CHAINS_X1_CUSTOMRPCURLS=http://127.0.0.1:8899,https://rpc.mainnet.x1.xyz
# only relay our route — never act as a general relayer
HYP_WHITELIST='[{"senderAddress":["__LOCKBOX_BYTES32__","__X1_TOKEN_PROGRAM_BYTES32__"],"recipientAddress":["__LOCKBOX_BYTES32__","__X1_TOKEN_PROGRAM_BYTES32__"]}]'
# pilot: no IGP — relayer subsidises gas; see docs/09-costs.md
HYP_GASPAYMENTENFORCEMENT='[{"type":"none"}]'
HYP_CHAINS_ETHEREUM_SIGNER_TYPE=aws
HYP_CHAINS_ETHEREUM_SIGNER_ID=alias/vmpx-bridge-relayer-eth
HYP_CHAINS_X1_SIGNER_TYPE=hexKey
HYP_CHAINS_X1_SIGNER_KEY=__FROM_SECRET_STORE__
HYP_METRICSPORT=9091
